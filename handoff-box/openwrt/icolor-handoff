#!/bin/sh /etc/rc.common
# OpenWrt / GL.iNet procd init script for the iColor handoff box.
# Install to /etc/init.d/icolor-handoff  (chmod +x), then:
#   /etc/init.d/icolor-handoff enable
#   /etc/init.d/icolor-handoff start
#
# Adjust STORAGE to your microSD mount (check `ls /mnt` — often /mnt/mmcblk0p1
# on the Beryl's microSD, or /mnt/sda1 for a USB stick).

USE_PROCD=1
START=95
STOP=10

STORAGE=/mnt/mmcblk0p1
BIN=$STORAGE/icolor-handoff
CERTDIR=/etc/icolor

start_service() {
	procd_open_instance
	procd_set_param command "$BIN" \
		-dir "$STORAGE/captures" \
		-https :8443 \
		-cert "$CERTDIR/fullchain.cer" \
		-key "$CERTDIR/handoff.key" \
		-end-of-day
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
